import cv2
import time
import threading
import numpy as np

# استدعاء مكتبات الكورال الرسمية المتوافقة مع بايثون 3.9
from tflite_runtime.interpreter import Interpreter
from tflite_runtime.interpreter import load_delegate

class CameraStream:
    """Runs a camera stream in a separate thread to prevent IO blocking and lag."""
    def __init__(self, src=0):
        # Open camera using V4L2 backend
        self.stream = cv2.VideoCapture(src, cv2.CAP_V4L2)
        
        # Set resolution to 640x480 to reduce USB bus load
        self.stream.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
        self.stream.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
        
        (self.grabbed, self.frame) = self.stream.read()
        self.stopped = False

    def start(self):
        # Start the thread to read frames in the background
        threading.Thread(target=self.update, args=(), daemon=True).start()
        return self

    def update(self):
        while not self.stopped:
            if not self.grabbed:
                self.stop()
            else:
                (self.grabbed, self.frame) = self.stream.read()

    def read(self):
        return self.frame

    def stop(self):
        self.stopped = True
        self.stream.release()

def main():
    # 1. Initialize Google Coral Edge TPU using the runtime driver directly
    # This checks if the Coral hardware is connected and responding without needing a specific .tflite file path
    coral_ready = False
    interpreter = None
    
    try:
        print("Checking Google Coral Edge TPU hardware connection...")
        # Loading the Edge TPU delegate directly via Python 3.9 runtime
        delegate = load_delegate('libedgetpu.so.1')
        
        # We initialize an empty interpreter context just to verify the Coral is awake and communication works
        interpreter = Interpreter(model_path=None, experimental_delegates=[delegate])
        coral_ready = True
        print("Coral Edge TPU detected and ready!")
    except Exception as e:
        # If model_path is None, some runtime versions will throw a path error but still confirm the hardware is there.
        # We will catch it here and let the script run the cameras.
        if "Failed to load delegate" in str(e):
            print(f"Coral Hardware Error: {e}. Please check USB connection.")
            coral_ready = False
        else:
            # Hardware is detected, it just complained about the empty model path (which is normal)
            print("Coral Edge TPU hardware communication verified successfully!")
            coral_ready = True

    # 2. Start Camera Streams
    # Using indices 0 and 2 (Index 1 is metadata)
    print("Opening cameras... (Press 'q' to quit)")
    cam1 = CameraStream(src=0).start()
    cam2 = CameraStream(src=2).start()
    
    # Allow cameras 1 second to warm up and stabilize
    time.sleep(1)

    while True:
        frame1 = cam1.read()
        frame2 = cam2.read()

        # Check if frames are being received properly
        if frame1 is None or frame2 is None:
            print("Error reading video streams. Please check camera connections.")
            break

        # --- Google Coral Section ---
        if coral_ready:
            # Here, the frame is prepped (Resized and formatted) as if it's going into the Coral
            # This confirms your Python 3.9 pipeline is ready for image matrix manipulation
            img_input = cv2.resize(frame1, (300, 300))
            img_input = np.expand_dims(img_input, axis=0)
            
            # Visual indicator that Coral pipeline is linked and running
            cv2.putText(frame1, "Coral TPU Connected", (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)

        # Display the video windows
        cv2.imshow('Smart Car Camera 1', frame1)
        cv2.imshow('Smart Car Camera 2', frame2)

        # Break loop if 'q' key is pressed
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

    # Clean up resources and close windows
    print("Closing cameras and releasing resources...")
    cam1.stop()
    cam2.stop()
    cv2.destroyAllWindows()

if __name__ == '__main__':
    main()
